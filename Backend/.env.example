# One SMTP login sends every email. Port 465 -> SMTP_SECURE=true, port 587 -> SMTP_SECURE=false.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Sender name shown in the inbox. Leave "ITUS" out unless MAIL_FROM is an @itus.net.in address (Microsoft 365
# quarantines outside senders that use the company's name).
MAIL_FROM_NAME=

# Where each form is delivered (several addresses: separate with commas).
ENQUIRY_TO=
CAREERS_TO=
