# Dependencies
node_modules/

# Build output (regenerated by `npm run build`)
dist/
dist-ssr/
*.tsbuildinfo

# Source design assets: original PNG exports. The optimised WebP versions
# live in public/images and are what the site actually uses.
public/NewAssets/

# Environment files (keep secrets out of git)
.env
.env.*
!.env.production
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tool caches and test output
.vite/
.cache/
.eslintcache
coverage/

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local assistant / scratch files
.claude/

# Local deployment archives
*.zip
